{
  "manifest_version": 3,
  "name": "Puzzle Streaks",
  "version": "1.0.0",
  "description": "Logs your LinkedIn game results to your Puzzle Streaks page.",
  "permissions": ["storage"],
  "action": { "default_popup": "popup.html", "default_title": "Puzzle Streaks" },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/games/*"],
      "js": ["linkedin.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://rsuriprojects.github.io/puzzle-streaks/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
